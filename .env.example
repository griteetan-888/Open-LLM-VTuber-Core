# Open-LLM-VTuber 环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置值
# 注意：.env 文件不会被提交到 Git（已在 .gitignore 中）

# ==================== OpenAI API 配置 ====================
# OpenAI API 密钥（必需，如果使用 OpenAI 模型）
OPENAI_API_KEY=your_openai_api_key_here

# ==================== 其他 LLM API 配置 ====================
# Claude API 密钥（可选，如果使用 Claude 模型）
CLAUDE_API_KEY=your_claude_api_key_here

# Groq API 密钥（可选，如果使用 Groq 模型）
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API 密钥（可选，如果使用 DeepSeek 模型）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Zhipu API 密钥（可选，如果使用 Zhipu 模型）
ZHIPU_API_KEY=your_zhipu_api_key_here

# Mistral API 密钥（可选，如果使用 Mistral 模型）
MISTRAL_API_KEY=your_mistral_api_key_here

# ==================== TTS 服务配置 ====================
# Azure TTS API 密钥（可选，如果使用 Azure TTS）
AZURE_TTS_API_KEY=your_azure_tts_api_key_here
AZURE_TTS_REGION=your_azure_region_here

# Minimax TTS 配置（可选，如果使用 Minimax TTS）
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_API_KEY=your_minimax_api_key_here

# Fish API TTS 配置（可选，如果使用 Fish API TTS）
FISH_API_KEY=your_fish_api_key_here

# ==================== ASR 服务配置 ====================
# Azure ASR API 密钥（可选，如果使用 Azure ASR）
AZURE_ASR_API_KEY=your_azure_asr_api_key_here

# Groq Whisper API 密钥（可选，如果使用 Groq Whisper）
GROQ_WHISPER_API_KEY=your_groq_whisper_api_key_here

# ==================== 其他服务配置 ====================
# Hume AI API 密钥（可选，如果使用 Hume AI Agent）
HUME_AI_API_KEY=your_hume_ai_api_key_here

# ==================== 使用说明 ====================
# 1. 复制此文件：cp .env.example .env
# 2. 编辑 .env 文件，填入你的实际 API 密钥
# 3. 在 conf.yaml 中，可以使用 ${OPENAI_API_KEY} 来引用环境变量
#    例如：llm_api_key: '${OPENAI_API_KEY}'
# 4. 或者直接在代码中通过 os.getenv("OPENAI_API_KEY") 读取
